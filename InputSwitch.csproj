<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms runs the tray icon and message loop; WPF (Fluent theme) draws the windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF0001: the Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>InputSwitch</AssemblyName>
    <RootNamespace>InputSwitch</RootNamespace>
    <Product>InputSwitch</Product>
    <Description>Tray utility that switches monitor inputs over DDC/CI with per-setup hotkeys.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- WinForms and WPF share many type names; each file imports the one it uses. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Developer tools have their own projects. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Page Remove="tools/**" />
  </ItemGroup>

</Project>
