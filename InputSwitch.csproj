<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms runs the tray icon and message loop; WPF (Fluent theme) draws the windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF0001: the Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>InputSwitch</AssemblyName>
    <RootNamespace>InputSwitch</RootNamespace>
    <Product>InputSwitch</Product>
    <Description>Tray utility that switches monitor inputs over DDC/CI with per-setup hotkeys.</Description>
    <!--
      The app version. This is the single source of truth: bump it in the change that prepares a
      release, merge to main, then tag that commit vX.Y.Z. The release workflow refuses a tag that
      doesn't match, and publishes the files CI built for that commit. AssemblyVersion/FileVersion
      derive from it, and the SDK appends the git commit to the informational version
      (e.g. 0.1.0+7c86e8a…).
    -->
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InputSwitch.SmokeTests" />
  </ItemGroup>

  <!-- WinForms and WPF share many type names; each file imports the one it uses. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Developer tools and tests have their own projects. -->
  <ItemGroup>
    <Compile Remove="tools/**;tests/**" />
    <None Remove="tools/**;tests/**" />
    <Page Remove="tools/**;tests/**" />
  </ItemGroup>

</Project>
