<Window x:Class="InputSwitch.UI.BindingEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InputSwitch;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,20,28,20">
            <TextBlock x:Name="Heading" Text="Add hotkey" FontSize="22" FontWeight="SemiBold" />

            <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="MonitorBox" HorizontalAlignment="Stretch" SelectionChanged="OnMonitorChanged" />

            <TextBlock Text="Key combination" Style="{StaticResource FieldLabel}" />
            <ContentControl x:Name="HotkeyHost" Focusable="False" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,6,0,0"
                       Text="Click the box and press the keys. Use Ctrl, Alt or Win with a key (or F13–F24). Backspace clears it." />

            <TextBlock Text="Inputs" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,0,0,8"
                       Text="Tick one input to switch to it, two to toggle between them, or more to cycle through them in the order shown." />

            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="InputsList" MaxHeight="260" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="6,4,4,0">
                        <Button Style="{StaticResource RowIconButton}" Click="OnMoveUp" ToolTip="Move up" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" />
                        </Button>
                        <Button Style="{StaticResource RowIconButton}" Click="OnMoveDown" ToolTip="Move down" Margin="0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Other input code (hex)" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0" Padding="14,5" Click="OnAddCustom" />
                <TextBox x:Name="CustomCode" Width="90" HorizontalAlignment="Right" ToolTip="MCCS VCP 0x60 value, e.g. 1B" />
            </DockPanel>

            <Border Margin="0,16,0,0" CornerRadius="6" Padding="12,8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="Summary" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" MinWidth="100" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="OnAccept" />
                <Button Content="Cancel" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
